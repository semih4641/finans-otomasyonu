# Telegram Finans Botu Konfigürasyonu
# Bu dosyayı '.env' olarak kopyalayın ve değerleri doldurun.

# BotFather'dan aldığınız Telegram Bot Token
BOT_TOKEN=your_telegram_bot_token_here

# Uyarı mesajlarının gönderileceği Telegram Chat ID
# (Botu başlattıktan sonra /chatid komutuyla öğrenebilirsiniz)
CHAT_ID=your_chat_id_here

# Risk motoru (ACCOUNT_SIZE opsiyoneldir; yoksa miktar hesaplanmaz)
ACCOUNT_SIZE=
POSITION_RISK_PCT=1.0
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=2.0

# Portföy seviyesi risk limitleri (daha muhafazakar)
MAX_SECTOR_EXPOSURE_PCT=25.0
MAX_CORRELATION_EXPOSURE_PCT=35.0
MAX_PORTFOLIO_RISK_PCT=4.0
MAX_DRAWDOWN_PCT=8.0
CORRELATION_LOOKBACK_DAYS=60
MIN_CORRELATION_THRESHOLD=0.7
# Sektör eşleşmesi: SYMBOL:SECTOR, virgülle ayrılır
SECTOR_MAPPING=AKBNK.IS:BANK,ALARK.IS:HOLDING,ASELS.IS:DEFENSE,ASTOR.IS:ENERGY,BIMAS.IS:RETAIL,BRISA.IS:AUTO,CCOLA.IS:BEV,ENKAI.IS:ENERGY,EREGL.IS:STEEL,FROTO.IS:AUTO,GARAN.IS:BANK,GUBRF.IS:HOLDING,HEKTS.IS:REAL_ESTATE,ISCTR.IS:BANK,KCHOL.IS:HOLDING,KONTR.IS:AUTO,KRDMD.IS:CHEMICAL,MIATK.IS:AUTO,ODAS.IS:PAPER,OYAKC.IS:CEMENT,PGSUS.IS:AVIATION,PETKM.IS:PETROCHEM,SAHOL.IS:HOLDING,SASA.IS:INDUSTRIAL,SISE.IS:GLASS,TCELL.IS:TELECOM,THYAO.IS:AVIATION,TOASO.IS:AUTO,TUPRS.IS:ENERGY,YKBNK.IS:BANK,KOTON.IS:RETAIL,AAGYO.IS:REAL_ESTATE,LINK.IS:TECH,ALTNY.IS:GOLD
